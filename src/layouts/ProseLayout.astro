---
/**
 * ProseLayout.astro
 * Shared inner layout for blog posts and project detail pages.
 * Wraps <slot /> in a styled prose container with sidebar-aware grid.
 */

interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  readingTime?: number;
  githubUrl?: string;
  liveUrl?: string;
  coverImage?: string;
  languages?: string[];
  frameworks?: string[];
  tools?: string[];
  kind: 'blog' | 'project' | 'profile' | 'other';
  backHref: string;
  backLabel: string;
}

const {
  title,
  description,
  date,
  tags = [],
  languages = [],
  frameworks = [],
  tools = [],
  readingTime,
  githubUrl,
  liveUrl,
  coverImage,
  kind,
  backHref,
  backLabel,
} = Astro.props;

// Combine split technologies for display
const combinedTech = Array.from(new Set([...languages, ...frameworks, ...tools]));

const formattedDate = date
  ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<article class="prose-page">
  <div class="container">

    <!-- Back link -->
    <a href={backHref} class="back-link" id="prose-back-link" aria-label={`Back to ${backLabel}`}>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M12 7H2M6 3L2 7l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      {backLabel}
    </a>

    <div class="prose-grid">

      <!-- Main content column -->
      <div class="prose-main">

        <!-- Header -->
        <header class="prose-header">
          <!-- Kind badge -->
          <span
            class={`kind-badge kind-badge--${kind === 'blog' ? 'blog' : kind === 'project' ? 'project' : 'other'}`}
            aria-label={
              kind === 'blog'
                ? 'Blog post'
                : kind === 'project'
                ? 'Project'
                : kind.charAt(0).toUpperCase() + kind.slice(1)
            }
          >
            {kind === 'blog'
              ? '// post'
              : kind === 'project'
              ? '// project'
              : `// ${kind}`}
          </span>

          <h1 class="prose-title">{title}</h1>

          {description && (
            <p class="prose-description">{description}</p>
          )}

          {/* Meta: date + reading time */}
          {(formattedDate || readingTime) && (
            <div class="prose-meta">
              {formattedDate && (
                <time datetime={date?.toISOString()} class="prose-date">
                  {formattedDate}
                </time>
              )}
              {formattedDate && readingTime && (
                <span class="meta-sep" aria-hidden="true">·</span>
              )}
              {readingTime && (
                <span class="prose-reading-time">{readingTime} min read</span>
              )}
            </div>
          )}

          {/* Tags & Tech */}
          <div style={{ display: 'flex', flexDirection: 'column', gap: '0.75rem' }}>
            {/* Concept Tags */}
            {tags.length > 0 && (
              <div class="prose-tags" role="list" aria-label="Project domains">
                {tags.map(tag => (
                  <span class="prose-tag prose-tag--concept" role="listitem">{tag}</span>
                ))}
              </div>
            )}

            {/* Technologies */}
            {combinedTech.length > 0 && (
              <div class="prose-tags" role="list" aria-label="Technologies used">
                {combinedTech.map(tech => (
                  <span class="prose-tag" role="listitem">{tech}</span>
                ))}
              </div>
            )}
          </div>

          {/* Project action links */}
          {(githubUrl || liveUrl) && (
            <div class="prose-links">
              {githubUrl && (
                <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="prose-action-link">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  View on GitHub
                </a>
              )}
              {liveUrl && (
                <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="prose-action-link">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2 12L12 2M12 2H6M12 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  Live Demo
                </a>
              )}
            </div>
          )}
        </header>

        {/* Cover image */}
        {coverImage && (
          <div class="prose-cover">
            <img src={coverImage} alt={`Cover image for ${title}`} loading="lazy" decoding="async" />
          </div>
        )}

        <!-- MDX content -->
        <div class="prose-body">
          <slot />
        </div>
      </div>

      <!-- Right sidebar (ToC injected via JS) -->
      <aside class="prose-sidebar" aria-label="Table of contents">
        <div class="toc-wrap" id="toc-wrap">
          <p class="toc-title">On this page</p>
          <nav id="toc" aria-label="Page sections"></nav>
        </div>
      </aside>

    </div>
  </div>
</article>

<!-- Auto-build ToC from headings -->
<script>
  const tocNav = document.getElementById('toc');
  const tocWrap = document.getElementById('toc-wrap');
  if (!tocNav || !tocWrap) throw new Error('ToC elements not found');

  const headings = Array.from(
    document.querySelectorAll<HTMLHeadingElement>('.prose-body h2, .prose-body h3')
  );

  if (headings.length < 2) {
    tocWrap.style.display = 'none';
  } else {
    const ul = document.createElement('ul');
    ul.className = 'toc-list';

    headings.forEach((h) => {
      // Auto-assign ID if missing
      if (!h.id) {
        h.id = h.textContent!
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '');
      }

      const li = document.createElement('li');
      li.className = `toc-item toc-${h.tagName.toLowerCase()}`;

      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = h.textContent ?? '';
      a.className = 'toc-link';

      li.appendChild(a);
      ul.appendChild(li);
    });

    tocNav.appendChild(ul);

    // Highlight active section on scroll
    const observerOptions = {
      rootMargin: '-80px 0% -80% 0%', 
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          
          // 1. Remove active class from all links
          tocNav.querySelectorAll('.toc-link').forEach((link) => {
            link.classList.remove('toc-link--active');
          });

          // 2. Add active class to the one that just entered the trigger zone
          const activeLink = tocNav.querySelector(`.toc-link[href="#${id}"]`);
          if (activeLink) {
            activeLink.classList.add('toc-link--active');
          }
        }
      });
    }, observerOptions);

    headings.forEach((h) => observer.observe(h));
  }
</script>

<style>
  .prose-page {
    padding-block: 3rem 5rem;
  }

  /* Back link */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.03em;
    margin-bottom: 2.5rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--accent); }

  /* Two-column grid */
  .prose-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .prose-grid { grid-template-columns: 1fr 220px; }
  }

  /* Header */
  .prose-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .kind-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    width: fit-content;
  }
  .kind-badge--blog {
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--accent-glow);
  }
  .kind-badge--project {
    color: var(--prose-purple);
    background: var(--prose-purple-dim);
    border: 1px solid var(--prose-purple-dim);
  }
  .kind-badge--other {
    color: var(--prose-orange);
    background: var(--prose-orange-dim);
    border: 1px solid var(--prose-orange-dim2);
  }

  .prose-title {
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--text);
  }

  .prose-description {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 64ch;
  }

  .prose-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .meta-sep { color: var(--border); }

  .prose-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .prose-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--accent-glow);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .prose-tag--concept {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--border);
    font-size: 0.625rem;
    font-weight: 600;
  }

  .prose-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .prose-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border);
    padding: 0.45rem 1rem;
    border-radius: 8px;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .prose-action-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-dim);
  }

  /* Cover */
  .prose-cover {
    margin-bottom: 2rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .prose-cover img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* ─── PROSE BODY ───────────────────────────────────────────── */
  .prose-body {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
    max-width: 72ch;
  }

  .prose-body :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 80px;
  }

  .prose-body :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 80px;
  }

  .prose-body :global(h4) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-top: 1.5rem;
    margin-bottom: 0.375rem;
  }

  .prose-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent-glow);
    transition: text-decoration-color 0.2s;
  }
  .prose-body :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .prose-body :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose-body :global(em) {
    color: var(--text);
    font-style: italic;
  }

  .prose-body :global(ul),
  .prose-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .prose-body :global(li) { line-height: 1.7; }

  .prose-body :global(ul li)::marker { color: var(--accent); }
  .prose-body :global(ol li)::marker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .prose-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--accent-dim);
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: var(--text);
  }

  .prose-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--accent);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  /* Shiki code blocks */
  .prose-body :global(pre) {
    background: var(--code-bg) !important;
    border: 1px solid var(--code-border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose-body :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .prose-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .prose-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }
  .prose-body :global(th) {
    text-align: left;
    font-weight: 600;
    color: var(--text);
    border-bottom: 1px solid var(--accent);
    padding: 0.5rem 0.75rem;
  }
  .prose-body :global(td) {
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    color: var(--muted);
  }
  .prose-body :global(tr:last-child td) { border-bottom: none; }

  .prose-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
    margin: 1.5rem 0;
  }

  /* ─── SIDEBAR / TOC ───────────────────────────────────────── */
  .prose-sidebar {
    display: none;
  }
  @media (min-width: 1024px) {
    .prose-sidebar {
      display: block;
      position: sticky;
      top: 84px;
    }
  }

  .toc-wrap {
    border-left: 1px solid var(--border);
    padding-left: 1.25rem;
  }

  .toc-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .toc-item { 
    margin: 0;
    color: var(--muted);
  }

  .toc-h3 { padding-left: 0.875rem; }

  .toc-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.5;
    display: block;
    padding: 0.2rem 0;
    transition: color 0.15s;
    border-left: 2px solid transparent;
    margin-left: -1.25rem;
    padding-left: 1rem;
  }
  .toc-link:hover { color: var(--text); }
  .toc-link--active {
    color: var(--toc-active);
    border-left-color: var(--toc-active);
  }

  .toc-wrap :global(.toc-list) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0; 
    margin: 0;
  }

  .toc-wrap :global(.toc-item) { 
    margin: 0;
    color: var(--muted);
  }

  .toc-wrap :global(.toc-h3) { padding-left: 0.875rem; }

  .toc-wrap :global(.toc-link) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.5;
    display: block;
    padding: 0.2rem 0;
    transition: color 0.15s;
    border-left: 2px solid transparent;
    margin-left: -1.25rem;
    padding-left: 1rem;
  }

  .toc-wrap :global(.toc-link:hover) { 
    color: var(--text); 
  }

  .toc-wrap :global(.toc-link--active) {
    color: var(--toc-active);
    border-left-color: var(--toc-active);
  }
</style>

<script>
  const backLink = document.getElementById('prose-back-link');
  if (backLink && window.history.length > 1) {
    backLink.addEventListener('click', (e) => {
      // If we have a referrer and it's from the same site, go back instead of to default href
      if (document.referrer && document.referrer.includes(window.location.host)) {
        e.preventDefault();
        window.history.back();
      }
    });
  }
</script>