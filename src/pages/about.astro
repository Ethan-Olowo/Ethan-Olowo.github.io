---
import Layout from "../layouts/Layout.astro";
import ProseLayout from "../layouts/ProseLayout.astro";
import { getCollection } from "astro:content";

const experience = await getCollection("experience");
const sortedExperience = experience.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="About Me"
  description="Technologist passionate about building data-driven solutions at the intersection of AI/ML, full-stack development, and business strategy."
>
  <ProseLayout
    title="About Me"
    description="Technologist passionate about building data-driven solutions at the intersection of AI/ML, full-stack development, and business strategy."
    kind="profile"
    backHref="/"
    backLabel="Home"
  >
    <div class="prose-body">
      <h2>Bridging Business &amp; <span class="hero-title-accent">Intelligent Systems</span></h2>
      <p>
        I’m Ethan Olowo, a technologist passionate about building data-driven solutions at the intersection of AI/ML, full-stack development, and business strategy. I thrive on solving complex, high-impact problems—especially those that empower organizations to make smarter decisions and deliver real-world value. My work is driven by curiosity, technical excellence, and a desire to lead teams that build for both innovation and reliability.
      </p>
      <p>
        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a> &nbsp;|&nbsp; <a href="/contact">Get in touch</a>
      </p>

      <h3 id="background">Background</h3>
      <p>
        My journey began with a fascination for how technology can transform business and society. Over the years, I’ve specialized in Business Intelligence, full-stack software, and AI/ML—always seeking to bridge technical depth with business value. I’m motivated by opportunities to lead, collaborate, and deliver solutions that are both innovative and robust.
      </p>
      <ul>
        <li><strong>First Class</strong> — Honors Graduate</li>
        <li><strong>12+</strong> — Projects shipped</li>
        <li><strong>4</strong> — Core domains</li>
        <li><strong>∞</strong> — Curiosity</li>
      </ul>

      <h3 id="academics">Academics</h3>
      <p>
        Graduated with First Class Honors in Business Information Technology from Strathmore University, specializing in Business Intelligence. Consistently top-performing in the IB Diploma and IGCSE, I’ve built a strong analytical foundation and a passion for extracting actionable insights from data.
      </p>

      <h3 id="experience">Work Experience</h3>
      <div class="experience-list">
        {sortedExperience.map(async (entry) => {
          const { Content } = await entry.render();
          const stack = [...entry.data.languages, ...entry.data.frameworks, ...entry.data.tools];
          
          return (
            <div class="experience-item">
              <div class="experience-header">
                <strong>{entry.data.company} ({entry.data.dateRange})</strong>
                <span class="experience-role">{entry.data.role}</span>
              </div>
              <div class="experience-body">
                <Content />
              </div>
              {stack.length > 0 && (
                <div class="experience-stack">
                  {stack.map(tech => (
                    <a href={`/skills?q=${encodeURIComponent(tech)}`} class="tech-pill-small tech-pill-link">
                      {tech}
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </ProseLayout>
</Layout>

<style>
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .experience-item {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
  }
  .experience-item:last-child {
    border-bottom: none;
  }
  .experience-header {
    margin-bottom: 0.5rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .experience-role {
    opacity: 0.7;
    font-size: 0.9rem;
  }
  .experience-body {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .experience-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tech-pill-small {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    opacity: 0.8;
  }
  .tech-pill-link {
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }
  .tech-pill-link:hover {
    background: var(--accent-dim, rgba(59, 130, 246, 0.1));
    border-color: var(--accent, #3b82f6);
    color: var(--accent, #3b82f6);
    opacity: 1;
  }
</style>
