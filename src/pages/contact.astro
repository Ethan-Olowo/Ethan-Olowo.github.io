---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';

// TODO: Replace all contact details with your real information
const contactChannels = [
  {
    label: 'Email',
    value: 'olowoethan@example.com',
    href: 'mailto:olowoethan@example.com',
    description: 'Best for detailed enquiries. I aim to reply within 48 hours.',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>`,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/ethan-olowo',
    href: 'https://www.linkedin.com/in/ethan-olowo',
    description: 'Connect for professional networking and opportunities.',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: 'GitHub',
    value: 'github.com/Ethan-Olowo',
    href: 'https://github.com/Ethan-Olowo',
    description: 'Browse my open-source work and active repositories.',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
  },
];

// What I'm open to — adjust to reflect your actual availability
const openTo = [
  { label: 'Full-time roles', active: true },
  { label: 'Contract / freelance', active: true },
  { label: 'Open-source collaboration', active: true },
  { label: 'Research partnerships', active: false },
];
---

<Layout
  title="Contact — Ethan Olowo"
  description="Get in touch about job opportunities, project collaboration, or anything else."
>
  <section class="contact-page" aria-labelledby="contact-heading">
    <div class="container">

      <!-- ── Page header ─────────────────────────────────────── -->
      <header class="page-header">
        <p class="page-label fade-up delay-1">Contact</p>
        <h1 class="page-title fade-up delay-2" id="contact-heading">
          Let's build<br />something together
        </h1>
        <p class="page-sub fade-up delay-3">
          Whether you have a role in mind, a project to discuss, or just want to connect —
          my inbox is open. Pick a channel below or use the form.
        </p>
      </header>

      <!-- ── Two-column layout ───────────────────────────────── -->
      <div class="contact-grid fade-up delay-3">

        <!-- LEFT: Form island -->
        <div class="form-col">
          <div class="form-card">
            <div class="form-card-header">
              <p class="card-label">// send_message</p>
              <span class="status-dot-wrap" aria-hidden="true">
                <span class="status-dot"></span>
                <span class="status-text">Online</span>
              </span>
            </div>
            <!-- React island — hydrates on page load for immediate interactivity -->
            <ContactForm client:load />
          </div>

          <!-- No-JS fallback -->
          <noscript>
            <p class="nojs-notice">
              JavaScript is disabled. Please email me directly at
              <a href="mailto:you@example.com">you@example.com</a>.
            </p>
          </noscript>
        </div>

        <!-- RIGHT: Info sidebar -->
        <aside class="info-col" aria-label="Contact information">

          <!-- Availability -->
          <div class="info-card">
            <p class="info-card-label">// availability</p>
            <ul class="open-to-list" aria-label="Open to">
              {openTo.map(({ label, active }) => (
                <li class="open-to-item">
                  <span class={`open-dot ${active ? 'open-dot--active' : 'open-dot--inactive'}`} aria-hidden="true"></span>
                  <span class={`open-label ${!active ? 'open-label--muted' : ''}`}>{label}</span>
                  <span class={`open-status ${active ? '' : 'open-status--no'}`}>{active ? 'Yes' : 'No'}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Contact channels -->
          <div class="info-card">
            <p class="info-card-label">// channels</p>
            <ul class="channel-list" aria-label="Contact channels">
              {contactChannels.map(({ label, value, href, description, icon }) => (
                <li class="channel-item">
                  <a
                    href={href}
                    class="channel-link"
                    target={href.startsWith('mailto') ? undefined : '_blank'}
                    rel={href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
                    aria-label={`${label}: ${value}`}
                  >
                    <span class="channel-icon" set:html={icon} />
                    <div class="channel-text">
                      <span class="channel-label">{label}</span>
                      <span class="channel-value">{value}</span>
                    </div>
                    <svg class="channel-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                  <p class="channel-desc">{description}</p>
                </li>
              ))}
            </ul>
          </div>

          <!-- Response time note -->
          <div class="info-card info-card--muted">
            <p class="info-card-label">// response_time</p>
            <p class="response-body">
              I typically respond within <strong>1–2 business days</strong>.
              For urgent matters, email is the fastest route.
            </p>
            <div class="timezone-row">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
              <!-- TODO: Update to your timezone -->
              <span class="timezone-text">Central European Time (CET / UTC+1)</span>
            </div>
          </div>

        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Page wrapper ───────────────────────────────────────── */
  .contact-page {
    padding-block: 4rem 6rem;
  }

  /* ── Header ─────────────────────────────────────────────── */
  .page-header {
    margin-bottom: 3.5rem;
    max-width: 600px;
  }

  .page-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.625rem;
  }

  .page-title {
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.06;
    color: var(--text);
    margin-bottom: 1.125rem;
  }

  .page-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 520px;
  }

  /* ── Two-column grid ─────────────────────────────────────── */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 380px;
      gap: 2rem;
    }
  }

  /* ── Form card ───────────────────────────────────────────── */
  .form-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }

  .form-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .card-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .status-dot-wrap {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.5);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  html.light .status-dot {
    background: #16a34a;
    box-shadow: 0 0 6px rgba(22, 163, 74, 0.4);
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.45; }
  }

  .status-text {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* The ContactForm React island renders directly into .form-card */
  .form-card :global(form),
  .form-card :global(> div) {
    padding: 1.5rem;
  }

  /* No-JS fallback */
  .nojs-notice {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    padding: 0.875rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .nojs-notice a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Info sidebar ────────────────────────────────────────── */
  .info-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
  }

  .info-card--muted {
    background: var(--bg);
  }

  .info-card-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 1rem;
    text-transform: lowercase;
  }

  /* ── Availability list ───────────────────────────────────── */
  .open-to-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .open-to-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .open-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .open-dot--active {
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent-glow);
  }

  .open-dot--inactive {
    background: var(--border);
  }

  .open-label {
    font-size: 0.875rem;
    color: var(--text);
    flex-grow: 1;
  }

  .open-label--muted {
    color: var(--muted);
  }

  .open-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .open-status--no {
    color: var(--muted);
  }

  /* ── Channel list ────────────────────────────────────────── */
  .channel-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .channel-item {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .channel-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .channel-item:first-child {
    padding-top: 0;
  }

  .channel-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-bottom: 0.3rem;
    padding: 0.375rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: 6px;
    transition: background-color 0.2s;
  }

  .channel-link:hover {
    background: var(--accent-dim);
  }

  .channel-link:hover .channel-label {
    color: var(--accent);
  }

  .channel-link:hover .channel-arrow {
    color: var(--accent);
    transform: translate(1px, -1px);
  }

  .channel-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--muted);
    flex-shrink: 0;
    transition: color 0.2s, border-color 0.2s;
  }

  .channel-link:hover .channel-icon {
    color: var(--accent);
    border-color: var(--accent);
  }

  .channel-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    flex-grow: 1;
    min-width: 0;
  }

  .channel-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    transition: color 0.2s;
  }

  .channel-value {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .channel-arrow {
    color: var(--border);
    flex-shrink: 0;
    transition: color 0.2s, transform 0.2s;
  }

  .channel-desc {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.55;
    padding-left: calc(34px + 0.75rem + 0.5rem);
  }

  /* ── Response time ───────────────────────────────────────── */
  .response-body {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 0.875rem;
  }

  .response-body strong {
    color: var(--text);
    font-weight: 600;
  }

  .timezone-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
  }

  .timezone-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
  }
</style>
