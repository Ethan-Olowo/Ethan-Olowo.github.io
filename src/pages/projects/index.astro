---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SearchBar from '../../components/SearchBar';

// Fetch all non-draft projects, sorted by order field
const allProjects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// Serialize for client component (dates → strings, etc.)
const projectItems = allProjects.map((p) => ({
  slug:        p.slug,
  title:       p.data.title,
  description: p.data.description,
  tags:        p.data.tags,
  languages:   p.data.languages,
  frameworks:  p.data.frameworks,
  tools:       p.data.tools,
  githubUrl:   p.data.githubUrl ?? '',
  liveUrl:     p.data.liveUrl   ?? '',
  featured:    p.data.featured,
  order:       p.data.order,
  type:        p.data.type,
  excerpt:     p.body
    .replace(/[#*_`>[\]|]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 200),
}));
---

<Layout
  title="Projects — Ethan Olowo"
  description="A collection of full-stack, machine learning, and data science projects."
>
  <section class="page-section">
    <div class="container">

      <!-- Page header -->
      <header class="page-header fade-up delay-1">
        <p class="page-label">Work</p>
        <h1 class="page-title">Projects</h1>
        <p class="page-sub">
          Systems I've designed and built spanning software, data science,
          ML, and applied AI.
        </p>
      </header>

      <!-- Filtered grid (React island) -->
      <div class="fade-up delay-2">
        <SearchBar
          client:load
          items={projectItems}
          type="project"
          emptyMessage="No projects found."
        />
      </div>

    </div>
  </section>
</Layout>

<style>
  .page-section {
    padding-block: 4rem 6rem;
  }

  .page-header {
    margin-bottom: 3rem;
    max-width: 640px;
  }

  .page-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text);
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .page-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--muted);
  }
</style>
