---
import Layout from "../layouts/Layout.astro";
import SkillsSearch from "../components/SkillsSearch";
---

<Layout
  title="Technical Skills"
  description="Explore my technical stack across projects, experience, and certifications."
>
  <section class="skills-page" aria-labelledby="skills-heading">
    <div class="container">

      <!-- ── Page header ─────────────────────────────────────── -->
      <header class="page-header">
        <p class="page-label fade-up delay-1">Explore</p>
        <h1 class="page-title fade-up delay-2" id="skills-heading">
          Technical Skills
        </h1>
        <p class="page-description fade-up delay-3">
          Search for a specific technology, language, or tool to see where I've applied it across my projects and professional experience.
        </p>
      </header>

      <!-- ── Search Component ────────────────────────────────── -->
      <div class="fade-up delay-4">
        <SkillsSearch client:load />
      </div>

    </div>
  </section>
</Layout>

<style>
  .skills-page {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  /* ── Header ──────────────────────────────────────────────── */
  .page-header {
    margin-bottom: 3rem;
  }

  .page-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .page-description {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 600px;
  }
</style>