---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SearchBar from '../../components/SearchBar';

// Fetch all non-draft blogs, sorted by order field
const allblogs = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// Serialize for client component (dates → strings, etc.)
const blogItems = allblogs.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags,
  coverImage: p.data.coverImage ?? '',
  readingTime: p.data.readingTime ?? '',
  date: p.data.date,
  excerpt:     p.body
    .replace(/```[\s\S]*?```/g, '')
    .replace(/[#*_`>[\]|]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 200),
}));
---

<Layout
  title="blogs — Ethan Olowo"
  description="A collection of blogs about my projects and learnings."
>
  <section class="page-section">
    <div class="container">

      <!-- Page header -->
      <header class="page-header fade-up delay-1">
        <p class="page-label">Work</p>
        <h1 class="page-title">Blogs</h1>
        <p class="page-sub">
          Thoughts on building intelligent systems, engineering trade-offs,
          research notes, and occasional deep-dives.
        </p>
      </header>

      <!-- Filtered grid (React island) -->
      <div class="fade-up delay-2">
        <SearchBar
          client:load
          items={blogItems}
          emptyMessage="No blogs found."
          type="blog"
        />
      </div>

    </div>
  </section>
</Layout>

<style>
  .page-section {
    padding-block: 4rem 6rem;
  }

  .page-header {
    margin-bottom: 3rem;
    max-width: 640px;
  }

  .page-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text);
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .page-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--muted);
  }
</style>
