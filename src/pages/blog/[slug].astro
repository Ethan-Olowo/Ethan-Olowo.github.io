---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProseLayout from '../../layouts/ProseLayout.astro';

/**
 * Pre-render one page per non-draft blog post.
 */
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data, slug } = post;
const { Content } = await post.render();

// Prev / next (by date, newest first)
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const currentIndex = allPosts.findIndex((p) => p.slug === slug);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;         // newer
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null; // older

// Compute reading time if not provided in frontmatter
// (~200 words/min average reading speed)
const wordsPerMinute = 200;
const wordCount = (await post.render()).remarkPluginFrontmatter?.wordCount as number | undefined;
const computedReadingTime = data.readingTime ?? (wordCount ? Math.ceil(wordCount / wordsPerMinute) : undefined);

// Related posts: share at least one tag, excluding current
const relatedPosts = allPosts
  .filter(
    (p) => p.slug !== slug && p.data.tags.some((t) => data.tags.includes(t))
  )
  .slice(0, 3);
---

<Layout
  title={`${data.title} — Blog`}
  description={data.description}
  ogImage={data.coverImage}
>
  <ProseLayout
    title={data.title}
    description={data.description}
    date={data.date}
    tags={data.tags}
    readingTime={computedReadingTime}
    coverImage={data.coverImage}
    kind="blog"
    backHref="/blog"
    backLabel="All Posts"
  >
    <Content />
  </ProseLayout>

  <!-- Related posts -->
  {relatedPosts.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <div class="container">
        <h2 class="related-title" id="related-heading">Related posts</h2>
        <div class="related-grid">
          {relatedPosts.map((p) => (
            <a href={`/blog/${p.slug}`} class="related-card">
              <p class="related-card-title">{p.data.title}</p>
              <p class="related-card-desc">{p.data.description}</p>
              <div class="related-tags">
                {p.data.tags.slice(0, 3).map((t) => (
                  <span class="related-tag">{t}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Prev / Next -->
  {(prevPost || nextPost) && (
    <nav class="post-nav" aria-label="Blog post navigation">
      <div class="container post-nav-inner">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}`} class="post-nav-link post-nav-link--prev">
            <span class="nav-dir">← Newer</span>
            <span class="nav-title">{prevPost.data.title}</span>
          </a>
        ) : <div />}

        {nextPost ? (
          <a href={`/blog/${nextPost.slug}`} class="post-nav-link post-nav-link--next">
            <span class="nav-dir">Older →</span>
            <span class="nav-title">{nextPost.data.title}</span>
          </a>
        ) : <div />}
      </div>
    </nav>
  )}
</Layout>

<style>
  /* Related posts */
  .related {
    padding-block: 3rem;
    border-top: 1px solid var(--border);
    margin-top: 1rem;
  }

  .related-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .related-card:hover {
    border-color: rgba(0,245,212,0.25);
    background: var(--bg-hover);
  }

  .related-card-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
  }

  .related-card-desc {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .related-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  /* Prev / Next */
  .post-nav {
    border-top: 1px solid var(--border);
    padding-block: 2rem;
  }

  .post-nav-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s, background 0.2s;
  }
  .post-nav-link:hover {
    border-color: rgba(0,245,212,0.3);
    background: var(--bg-card);
  }
  .post-nav-link--next { text-align: right; }

  .nav-dir {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }
  .nav-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }
</style>