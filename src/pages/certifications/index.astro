---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CertificationsView from '../../components/CertificationsView';

// Fetch all certifications, sorted by date completed (newest first)
const allCertifications = (await getCollection('certifications'))
  .sort((a, b) => b.data.dateCompleted.getTime() - a.data.dateCompleted.getTime());

// Serialize for client component
const certItems = allCertifications.map((c) => ({
  slug: c.slug,
  title: c.data.title,
  issuer: c.data.issuer,
  dateCompleted: c.data.dateCompleted.toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
  }),
  tags: c.data.tags,
  languages: c.data.languages,
  frameworks: c.data.frameworks,
  tools: c.data.tools,
  badgeImage: c.data.badgeImage,
  credentialUrl: c.data.credentialUrl,
}));
---

<Layout
  title="Certifications — Ethan Olowo"
  description="Professional certifications and badges in Cloud Computing, AI, and Software Engineering."
>
  <section class="page-section">
    <div class="container">

      <!-- Page header -->
      <header class="page-header fade-up delay-1">
        <p class="page-label">Learning</p>
        <h1 class="page-title">Certifications</h1>
        <p class="page-sub">
          Validated expertise and technical proficiencies acquired through 
          rigorous training and industry-recognized certifications.
        </p>
      </header>

      <!-- Filtered list (React island) -->
      <div class="fade-up delay-2">
        <CertificationsView
          client:load
          items={certItems}
        />
      </div>

    </div>
  </section>
</Layout>

<style>
  .page-section {
    padding-block: 4rem 6rem;
  }

  .page-header {
    margin-bottom: 3rem;
    max-width: 640px;
  }

  .page-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text);
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .page-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--muted);
  }
</style>
